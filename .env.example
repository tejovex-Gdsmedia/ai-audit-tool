# Supabase Credentials Configuration (Client-side)
# Rename this file to .env and replace the values below with your actual Supabase URL and Anon Key.
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-string

# Gemini API Configuration (Server-side ONLY - Set in Netlify Environment Variables)
# Never expose or prefix with VITE_ to keep it secure from client code.
GEMINI_API_KEY=your-gemini-api-key-here

